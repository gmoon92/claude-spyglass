// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`AgentSpikeBadge 골든마스터 > spike ×4 1`] = `"<span class="mini-badge badge-spike ds-badge" data-tone="warn" data-spike-variant="agent" data-mini-badge-tooltip="agent-spike" title="Agent is 4× parent row · Agent token spike · ↑×4 · split session" aria-label="Agent is 4× parent row · Agent token spike · ↑×4 · split session">↑<span class="agent-spike-count">×4</span></span>"`;

exports[`BloatedSysBadge 골든마스터 > dot critical (노출) 1`] = `"<span class="badge-bloated-sys badge-bloated-sys--dot is-critical ds-dot" data-tone="error" data-bloated-sys-stage="critical" title="system dominates user (71%) · system dominates · compact won't help" aria-label="system dominates user (71%) · system dominates · compact won't help"></span>"`;

exports[`BloatedSysBadge 골든마스터 > full critical 1`] = `"<span class="badge-bloated-sys badge-bloated-sys--full is-critical ds-badge" data-tone="error" data-bloated-sys-stage="critical" data-mini-badge-tooltip="bloated-sys" title="system dominates user (71%) · system dominates · compact won't help" aria-label="system dominates user (71%) · system dominates · compact won't help">bloated 71%</span>"`;

exports[`BloatedSysBadge 골든마스터 > full warn 1`] = `"<span class="badge-bloated-sys badge-bloated-sys--full is-warn ds-badge" data-tone="warn" data-bloated-sys-stage="warn" data-mini-badge-tooltip="bloated-sys" title="system context bloated (42%) · system bloated · /mcp list" aria-label="system context bloated (42%) · system bloated · /mcp list">sys 42%</span>"`;

exports[`BloatedSysBadge 골든마스터 > mini critical 1`] = `"<span class="badge-bloated-sys badge-bloated-sys--mini is-critical ds-badge" data-tone="error" data-bloated-sys-stage="critical" data-mini-badge-tooltip="bloated-sys" title="system dominates user (71%) · system dominates · compact won't help" aria-label="system dominates user (71%) · system dominates · compact won't help">bloated 71%</span>"`;

exports[`BloatedSysBadge 골든마스터 > mini warn 1`] = `"<span class="badge-bloated-sys badge-bloated-sys--mini is-warn ds-badge" data-tone="warn" data-bloated-sys-stage="warn" data-mini-badge-tooltip="bloated-sys" title="system context bloated (42%) · system bloated · /mcp list" aria-label="system context bloated (42%) · system bloated · /mcp list">sys 42%</span>"`;

exports[`BloatedSysBadge 골든마스터 > pct 누락 → ? 1`] = `"<span class="badge-bloated-sys badge-bloated-sys--mini is-warn ds-badge" data-tone="warn" data-bloated-sys-stage="warn" data-mini-badge-tooltip="bloated-sys" title="system context bloated (?%) · system bloated · /mcp list" aria-label="system context bloated (?%) · system bloated · /mcp list">sys ?%</span>"`;

exports[`ContextSaturationBadge 골든마스터 > critical 1`] = `"<span class="badge-context-saturation badge-context-saturation--full is-critical ds-badge" data-tone="error" data-context-saturation-stage="critical" title="Session context 88% used — approaching limit · /clear or /compact recommended" aria-label="Session context 88% used — approaching limit · /clear or /compact recommended">▦ ctx 88%</span>"`;

exports[`ContextSaturationBadge 골든마스터 > warn 1`] = `"<span class="badge-context-saturation badge-context-saturation--full is-warn ds-badge" data-tone="warn" data-context-saturation-stage="warn" title="Session context 55% used — approaching limit · /clear or /compact recommended" aria-label="Session context 55% used — approaching limit · /clear or /compact recommended">▦ ctx 55%</span>"`;

exports[`TurnSpikeSummary 골든마스터 > spike with empty samples (baseline) 1`] = `"<span class="turn-spike-summary" title="↑5× larger than parent row" aria-label="↑5× larger than parent row"><span class="turn-spike-summary-label">↑5× larger than parent row</span><span class="turn-spike-summary-spark"><svg viewbox="0 0 60 16" preserveaspectratio="none" aria-hidden="true"><line x1="0" y1="15" x2="60" y2="15" stroke="currentColor" stroke-opacity="0.18" stroke-width="1"></line></svg></span></span>"`;

exports[`TurnSpikeSummary 골든마스터 > spike with samples 1`] = `"<span class="turn-spike-summary" title="↑5× larger than parent row" aria-label="↑5× larger than parent row"><span class="turn-spike-summary-label">↑5× larger than parent row</span><span class="turn-spike-summary-spark"><svg viewbox="0 0 60 16" preserveaspectratio="none" aria-hidden="true"><path d="M 0.00 11.50 L 15.00 8.00 L 30.00 13.25 L 45.00 1.00 L 60.00 9.75 L 60 16 L 0 16 Z" fill="var(--color-accent-soft)"></path><path d="M 0.00 11.50 L 15.00 8.00 L 30.00 13.25 L 45.00 1.00 L 60.00 9.75" stroke="var(--color-accent)" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"></path><circle cx="45.00" cy="1.00" r="2" fill="var(--color-accent)"></circle></svg></span></span>"`;
